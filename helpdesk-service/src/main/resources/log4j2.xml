<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Console Output -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%t] %c{1} - %msg%n"/>
        </Console>

        <!-- Application Log (Rolling File): everything from INFO up.
             A new file is started each day, or when the file reaches 10 MB. -->
        <RollingFile name="ApplicationAppender"
                     fileName="logs/helpdesk-backend.log"
                     filePattern="logs/helpdesk-backend-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%t] %c{1} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
        </RollingFile>

        <!-- Error Log (Rolling File): only ERROR and FATAL messages (see level="error" below) -->
        <RollingFile name="ErrorAppender"
                     fileName="logs/helpdesk-backend-error.log"
                     filePattern="logs/helpdesk-backend-error-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%t] %c{1} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="ApplicationAppender"/>
            <AppenderRef ref="ErrorAppender" level="error"/>
        </Root>
    </Loggers>
</Configuration>
